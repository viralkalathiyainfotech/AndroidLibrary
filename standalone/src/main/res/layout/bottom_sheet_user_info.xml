<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSheetAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/standalone_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Leanne Graham" />

            <TextView
                android:id="@+id/tvSheetEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/standalone_text_secondary"
                android:textSize="13sp"
                tools:text="sincere@april.biz" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/standalone_divider" />

    <TextView
        android:id="@+id/tvSheetPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/standalone_text_primary"
        android:textSize="14sp"
        tools:text="Phone: 1-770-736-8031" />

    <TextView
        android:id="@+id/tvSheetWebsite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/standalone_accent"
        android:textSize="14sp"
        tools:text="Website: hildegard.org" />

    <TextView
        android:id="@+id/tvSheetAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/standalone_text_secondary"
        android:textSize="13sp"
        tools:text="Address: Kulas Light, Apt. 556, Gwenborough" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Close Details"
        app:backgroundTint="@color/standalone_primary"
        app:cornerRadius="8dp" />

</LinearLayout>
